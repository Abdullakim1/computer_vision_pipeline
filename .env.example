# ============================================================================
# CineForge Environment Configuration
# ============================================================================

# API Keys for Cloud Services
# Seedance (ByteDance Provenance)
SEEDANCE_API_KEY=your_seedance_api_key_here
SEEDANCE_API_ENDPOINT=https://seedance-api.example.com/v1/generate

# Luma (Luma AI Dream Machine)
LUMA_API_KEY=your_luma_api_key_here
LUMA_API_ENDPOINT=https://api.lumalabs.ai/dream-machine/v1

# Kling (Kua'you Video)
KLING_API_KEY=your_kling_api_key_here
KLING_API_ENDPOINT=https://api.klingai.com/v1/videos/generate

# Optional: OpenAI API (for enhanced prompts)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo

# ============================================================================
# Generation Settings
# ============================================================================

# Default Backend
default_backend=cinematic

# Default Resolution (width, height)
default_width=960
default_height=540

# Default FPS
default_fps=24

# Default Duration
default_duration=4.0

# ============================================================================
# Storage Paths
# ============================================================================

# Output Directory
output_dir=outputs

# Temporary Directory
temp_dir=/tmp/cineforge

# API Output Directory
api_output_dir=outputs/api

# UI Output Directory
ui_output_dir=outputs/ui

# Showcase Output Directory
showcase_output_dir=outputs/showcase

# ============================================================================
# Caching
# ============================================================================

# Cache prompts and results to avoid redundant generation
cache_enabled=true
cache_dir=outputs/cache

# Cache expiration time (hours)
cache_ttl=24

# ============================================================================
# Logging
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
log_level=INFO

# Log file path
log_file=logs/cineforge.log

# ============================================================================
# Performance
# ============================================================================

# Max concurrent generations
max_concurrent_generations=2

# Batch size for API calls
batch_size=4

# ============================================================================
# API Rate Limiting
# ============================================================================

# Delay between API calls (seconds)
api_delay=0.5

# Max retries for API calls
api_max_retries=3

# Retry delay (seconds)
retry_delay=1.0

# ============================================================================
# Optional Features
# ============================================================================

# Enable Torch for local latent diffusion
torch_enabled=false

torch_device=cuda

torch_dtype=float32

# Gradio Web UI
ggradio_port=7860
ggradio_host=0.0.0.0

ggradio_share=false

# FastAPI Server
api_port=8000
api_host=0.0.0.0
api_reload=true
