# ============================================================================
# CineForge Environment Configuration
# ============================================================================

# API Keys for Cloud Services
# Colab-hosted Wan (realistic T2V + I2V) — run
# colab/CineForge_Colab_Video_Server.ipynb on a Colab GPU (A100 recommended,
# falls back to a free T4) and paste the printed PUBLIC API URL here.
COLAB_BASE_URL=
COLAB_TIMEOUT=3600

# Local Wan 2.1 diffusion (realistic text-to-video on CUDA GPU)
WAN_MODEL_ID=Wan-AI/Wan2.1-T2V-1.3B-Diffusers
WAN_MODEL_CACHE=models/Wan2.1-T2V-1.3B-Diffusers
# Local image-to-video model (used by --backend local i2v)
WAN_I2V_MODEL_ID=Wan-AI/Wan2.1-I2V-1.3B-Diffusers
WAN_I2V_MODEL_CACHE=models/Wan2.1-I2V-1.3B-Diffusers

# Seedance (ByteDance Provenance)
SEEDANCE_API_KEY=your_seedance_api_key_here
SEEDANCE_BASE_URL=https://seedance-api.example.com/v1/generate

# Luma (Luma AI Dream Machine)
LUMA_API_KEY=your_luma_api_key_here
LUMA_BASE_URL=https://api.lumalabs.ai/dream-machine/v1

# Kling (Kua'you Video)
KLING_API_KEY=your_kling_api_key_here
KLING_BASE_URL=https://api.klingai.com/v1/videos/generate

# Google Veo (Gemini API) — free-tier video generation on Google's GPUs.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
VEO_MODEL=veo-3.1-fast-generate-preview
VEO_TIMEOUT=600
VEO_POLL_INTERVAL=10

# Optional: OpenAI API (for enhanced prompts)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo

# ============================================================================
# Generation Settings
# ============================================================================

# Default Backend
default_backend=cinematic

# Default Resolution (width, height)
default_width=960
default_height=540

# Default FPS
default_fps=24

# Default Duration
default_duration=4.0

# ============================================================================
# Storage Paths
# ============================================================================

# Output Directory
output_dir=outputs

# Temporary Directory
temp_dir=/tmp/cineforge

# API Output Directory
api_output_dir=outputs/api

# UI Output Directory
ui_output_dir=outputs/ui

# Showcase Output Directory
showcase_output_dir=outputs/showcase

# ============================================================================
# Caching
# ============================================================================

# Cache prompts and results to avoid redundant generation
cache_enabled=true
cache_dir=outputs/cache

# Cache expiration time (hours)
cache_ttl=24

# ============================================================================
# Logging
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
log_level=INFO

# Log file path
log_file=logs/cineforge.log

# ============================================================================
# Performance
# ============================================================================

# Max concurrent generations
max_concurrent_generations=2

# Batch size for API calls
batch_size=4

# ============================================================================
# API Rate Limiting
# ============================================================================

# Delay between API calls (seconds)
api_delay=0.5

# Max retries for API calls
api_max_retries=3

# Retry delay (seconds)
retry_delay=1.0

# ============================================================================
# Optional Features
# ============================================================================

# Enable Torch for local latent diffusion
torch_enabled=false

torch_device=cuda

torch_dtype=float32

# Gradio Web UI
# Web UI (FastAPI serves web/index.html at http://localhost:8000)
UI_PORT=8000

# FastAPI Server
api_port=8000
api_host=0.0.0.0
api_reload=true
